-- ━━━━━━━━━━━━━━━━━━━━━━ 玩家飛行鎖定物理幀同步 ━━━━━━━━━━━━━━━━━━━━━━
local function freezePlayerPhysics(char)
    if not char then return end
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.Velocity = BringZero
            part.RotVelocity = BringZero
            pcall(function()
                part.AssemblyLinearVelocity = BringZero
                part.AssemblyAngularVelocity = BringZero
            end)
        end
    end
end

RunService.Heartbeat:Connect(function()
    if State.AutoFarm and character and hrp and humanoid and humanoid.Health > 0 then
        if FarmPos then
            freezePlayerPhysics(character)
            local targetPos = FarmPos.Position + Vector3.new(0, CONFIG.AboveMonsterOffset, 0)
            hrp.CFrame = CFrame.new(targetPos)
        end
    end
end)

-- ━━━━━━━━━━━━━━━━━━━━━━ 主邏輯與關卡掃描 ━━━━━━━━━━━━━━━━━━━━━━
local dungeonTeleporting = false
local lastDungeonTeleport = 0
local enterRoomTime = tick() 

task.spawn(function()
    while true do
        task.wait(0.08)
        getRef()
        
        if not character or not hrp or not humanoid or humanoid.Health <= 0 then
            State.StatusText = "等待角色重生..."
            status.Text = "關卡：第 " .. tostring(State.LockedLevel) .. " 關\n狀態：" .. State.StatusText
            continue 
        end
        
        local map = workspace:FindFirstChild("Map")
        local dungeon = map and map:FindFirstChild("Dungeon")
        if dungeon then
            for _, lv in pairs(dungeon:GetChildren()) do
                local n = tonumber(lv.Name)
                local floor = lv:FindFirstChild("Floor") or lv:FindFirstChildWhichIsA("BasePart")
                if n and floor and (hrp.Position - floor.Position).Magnitude < 600 then
                    if State.LockedLevel ~= n then
                        State.LockedLevel = n
                        enterRoomTime = tick() 
                    end
                end
            end
        end

        doBuffs()
        callV4()
        autoEquipWeapon()

        if State.AutoFarm then
            local ef = workspace:FindFirstChild("Enemies")
            local closest, minDist = nil, math.huge
            local priorityTargets = {}

            if ef then
                for _, npc in ipairs(ef:GetChildren()) do
                    if npc.Name == "Blank Buddy" or isShadow(npc.Name) then continue end
                    local npcHum  = npc:FindFirstChild("Humanoid")
                    local npcRoot = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
                    if npcHum and npcHum.Health > Config.HealthMobThreshold and npcRoot then
                        local d = (npcRoot.Position - hrp.Position).Magnitude
                        if npc.Name == "PropHitboxPlaceholder" and d <= 600 then
                            table.insert(priorityTargets, npcRoot)
                        end
                        if d < minDist and d <= 600 then
                            minDist = d
                            closest = npcRoot
                        end
                    end
                end
            end

            local target = (#priorityTargets > 0) and priorityTargets[1] or closest

            if target then
                enterRoomTime = 0 
                FarmPos = target.CFrame
                MonFarm = target.Parent and target.Parent.Name or ""

                pcall(function() target.CanCollide = false end)
                
                pcall(function()
                    local bv = hrp:FindFirstChild("FlyVelocity")
                    if not bv then
                        bv = Instance.new("BodyVelocity")
                        bv.Name = "FlyVelocity"
                        bv.Velocity = Vector3.new(0, 0, 0)
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Parent = hrp
                    end
                end)
                
                State.StatusText = "鎖定怪頭上: " .. (target.Parent and target.Parent.Name or "?")
            else
                FarmPos = nil
                MonFarm = nil

                local timeSinceEnter = tick() - enterRoomTime

                if timeSinceEnter < CONFIG.EnterRoomWaitTime then
                    local timeLeft = string.format("%.1f", CONFIG.EnterRoomWaitTime - timeSinceEnter)
                    State.StatusText = "已進入第 " .. tostring(State.LockedLevel) .. " 關，等待怪物生成 (" .. timeLeft .. "s)..."
                    
                    pcall(function()
                        local bv = hrp:FindFirstChild("FlyVelocity")
                        if not bv then
                            bv = Instance.new("BodyVelocity")
                            bv.Name = "FlyVelocity"
                            bv.Velocity = Vector3.new(0, 0, 0)
                            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bv.Parent = hrp
                        end
                    end)
                else
                    if not dungeonTeleporting then
                        local mapObj = workspace:FindFirstChild("Map")
                        local dungeonObj = mapObj and mapObj:FindFirstChild("Dungeon")
                        local targetExit, exitMinDist = nil, math.huge
                        
                        if dungeonObj then
                            for _, level in ipairs(dungeonObj:GetChildren()) do
                                if tonumber(level.Name) then
                                    local tp = level:FindFirstChild("ExitTeleporter")
                                    if tp then
                                        local root = tp:FindFirstChild("Root") or tp:FindFirstChildWhichIsA("BasePart")
                                        if root then
                                            local d = (hrp.Position - root.Position).Magnitude
                                            if d < exitMinDist and d < 1000 then
                                                exitMinDist = d
                                                targetExit = root
                                            end
                                        end
                                    end
                                end
                            end
                        end

                        if targetExit and tick() - lastDungeonTeleport >= 2 then
                            dungeonTeleporting = true
                            lastDungeonTeleport = tick()
                            
                            enterRoomTime = tick() 
                            
                            TweenService:Create(hrp, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = targetExit.CFrame}):Play()
                            
                            task.delay(1.2, function() dungeonTeleporting = false end)
                            State.StatusText = "飛往下一關出口..."
                        else
                            pcall(function()
                                local bv = hrp:FindFirstChild("FlyVelocity")
                                if bv then bv:Destroy() end
                            end)
                            State.StatusText = "搜尋下一關出口中..."
                        end
                    end
                end
            end
        else
            pcall(function()
                local bv = hrp:FindFirstChild("FlyVelocity")
                if bv then bv:Destroy() end
            end)
            FarmPos = nil
            MonFarm = nil
            State.StatusText = Config.FastAttackMob and "快速攻擊待命 (手動走位)" or "待機中"
        end
        
        status.Text = "關卡：第 " .. tostring(State.LockedLevel) .. " 關\n狀態：" .. State.StatusText
    end
end)
