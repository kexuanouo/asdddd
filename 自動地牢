local Net              = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net")
local RegisterHit      = Net:WaitForChild("RE/RegisterHit")
local RegisterAttack   = Net:WaitForChild("RE/RegisterAttack")
local CancelEquipAnim  = Net:FindFirstChild("RE/CancelEquipAnim") or Net:FindFirstChild("RE/RemoveAnimation")
local LeftClickRemote  = Net:FindFirstChild("RE/LeftClickRemote") or Net:FindFirstChild("RE/FruitClick")

local function isShadow(name)
    local lower = string.lower(name)
    return string.find(lower, "shadow") ~= nil
        or string.find(name, "'s Shadow") ~= nil
        or string.find(name, "\u{2019}s Shadow") ~= nil
end

-- 果實 & Guitar 偵測
local M1Fruit = false
local Guitar = false

task.spawn(function()
    while true do
        task.wait(2)
        local flagFruit, flagGuitar = false, false
        local function scanContainer(container)
            if not container then return end
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local isChop = string.find(string.lower(item.Name), "chop") ~= nil
                    if (item:GetAttribute('WeaponType') == 'Demon Fruit' or item.ToolTip == "Blox Fruit") and item:FindFirstChild("LeftClickRemote") and not isChop then
