-- ━━━━━━━━━━━━━━━━━━━━━━ 聚怪邏輯（死鎖 Y 軸防下沉/漂浮 + 物理凍結版） ━━━━━━━━━━━━━━━━━━━━━━
local BringZero = Vector3.new(0, 0, 0)
local MonFarm = nil
local FarmPos = nil

local mobTracker = {}   -- 追蹤怪物的拉取時間與血量
local mobBlacklist = {} -- 黑名單 (5秒冷卻)
local spinAngle = 0     -- 用於計算旋轉的角度
local lockedY = nil     -- 死鎖聚怪平面的 Y 軸高度

local function freezeMobPhysics(model, isBring)
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Velocity = BringZero
            part.RotVelocity = BringZero
            pcall(function()
                part.AssemblyLinearVelocity = BringZero
                part.AssemblyAngularVelocity = BringZero
            end)
        end
    end
    
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = isBring
    end
end

task.spawn(function()
    while true do
        task.wait(0.02)
        local now = tick()
        spinAngle = (spinAngle + 35) % 360

        for mob, expireTime in pairs(mobBlacklist) do
            if now > expireTime then
                mobBlacklist[mob] = nil
            end
        end

        if State.AutoFarm and State.BringMob and FarmPos then
            if not lockedY then
                lockedY = FarmPos.Position.Y
            end
            
            local fixedCenter = Vector3.new(FarmPos.Position.X, lockedY, FarmPos.Position.Z)

            pcall(function()
                sethiddenproperty(player, "SimulationRadius", 1000)
                sethiddenproperty(player, "MaxSimulationRadius", 1000)
            end)

            local ef = workspace:FindFirstChild("Enemies")
            if ef then
                local bringCount = 0
                for _, v in ipairs(ef:GetChildren()) do
                    if bringCount >= 10 then break end
                    if v.Name == "Blank Buddy" or isShadow(v.Name) or mobBlacklist[v] then continue end

                    local root = v:FindFirstChild("HumanoidRootPart") or v.PrimaryPart
                    local hum  = v:FindFirstChildOfClass("Humanoid")

                    if root and hum and hum.Health > Config.HealthMobThreshold then
                        local distToCenter = (root.Position - fixedCenter).Magnitude

                        if distToCenter <= 120 then
                            if not mobTracker[v] then
                                mobTracker[v] = {
                                    startTime = now,
                                    startHealth = hum.Health,
                                    originalCFrame = root.CFrame
                                }
                            end

                            local tracker = mobTracker[v]
                            local duration = now - tracker.startTime

                            local healthDifference = tracker.startHealth - hum.Health
                            if duration >= 2.5 and healthDifference <= (hum.MaxHealth * 0.01) then
                                freezeMobPhysics(v, false)
                                root.CFrame = tracker.originalCFrame

                                mobBlacklist[v] = now + 5
                                mobTracker[v] = nil
                            else
                                bringCount = bringCount + 1
                                
                                freezeMobPhysics(v, true)
                                
                                local rad = math.rad(spinAngle + (bringCount * 36))
                                local offsetX = math.cos(rad) * 0.5
                                local offsetZ = math.sin(rad) * 0.8
                                
                                local baseCFrame = CFrame.new(fixedCenter.X + offsetX, fixedCenter.Y, fixedCenter.Z + offsetZ)
                                local rotation = CFrame.Angles(0, math.rad(spinAngle), 0) -- 原本的水平旋轉
                                local upsideDown = CFrame.Angles(math.rad(180), 0, 0)     -- 讓怪物翻轉180度（頭朝下）

root.CFrame = baseCFrame * rotation * upsideDown
                            end
                        else
                            mobTracker[v] = nil
                        end
                    else
                        mobTracker[v] = nil
                    end
                end
            end
        else
            lockedY = nil
            if next(mobTracker) then
                for mob, _ in pairs(mobTracker) do
                    if mob and mob.Parent then
                        freezeMobPhysics(mob, false)
                    end
                end
                mobTracker = {}
            end
        end
    end
end)

